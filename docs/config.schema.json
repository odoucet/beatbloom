{
  "$defs": {
    "EffectConfig": {
      "additionalProperties": false,
      "description": "Map a named signal to an additive effect or a multiplicative brightness range.",
      "properties": {
        "signal": {
          "minLength": 1,
          "title": "Signal",
          "type": "string"
        },
        "effect": {
          "enum": [
            "bloom",
            "exposure",
            "saturation",
            "zoom",
            "brightness"
          ],
          "title": "Effect",
          "type": "string"
        },
        "amount": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount"
        },
        "range": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "minimum": 0,
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Range"
        }
      },
      "required": [
        "signal",
        "effect"
      ],
      "title": "EffectConfig",
      "type": "object"
    },
    "SeparationConfig": {
      "additionalProperties": false,
      "description": "Options that affect the identity of cached Demucs output.",
      "properties": {
        "backend": {
          "const": "demucs",
          "default": "demucs",
          "title": "Backend",
          "type": "string"
        },
        "model": {
          "default": "htdemucs_6s",
          "enum": [
            "htdemucs_6s",
            "htdemucs"
          ],
          "title": "Model",
          "type": "string"
        },
        "device": {
          "default": "auto",
          "pattern": "^(auto|cpu|mps|cuda(:[0-9]+)?)$",
          "title": "Device",
          "type": "string"
        },
        "shifts": {
          "default": 1,
          "minimum": 0,
          "title": "Shifts",
          "type": "integer"
        },
        "overlap": {
          "default": 0.25,
          "exclusiveMaximum": 1,
          "minimum": 0,
          "title": "Overlap",
          "type": "number"
        },
        "segment": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 7,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Segment"
        },
        "jobs": {
          "default": 0,
          "minimum": 0,
          "title": "Jobs",
          "type": "integer"
        },
        "seed": {
          "default": 0,
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        }
      },
      "title": "SeparationConfig",
      "type": "object"
    },
    "SignalConfig": {
      "additionalProperties": false,
      "description": "One source and its analysis/envelope parameters, independent of video FPS.",
      "properties": {
        "stem": {
          "anyOf": [
            {
              "enum": [
                "mix",
                "drums",
                "bass",
                "vocals",
                "other",
                "guitar",
                "piano"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stem"
        },
        "source": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "low": {
          "anyOf": [
            {
              "exclusiveMaximum": 22050.0,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Low"
        },
        "high": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 22050.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "High"
        },
        "feature": {
          "default": "onset",
          "enum": [
            "onset",
            "rms",
            "loudness"
          ],
          "title": "Feature",
          "type": "string"
        },
        "attack_ms": {
          "default": 10.0,
          "minimum": 0,
          "title": "Attack Ms",
          "type": "number"
        },
        "release_ms": {
          "default": 400.0,
          "minimum": 0,
          "title": "Release Ms",
          "type": "number"
        },
        "gate": {
          "default": 0.0,
          "exclusiveMaximum": 1,
          "minimum": 0,
          "title": "Gate",
          "type": "number"
        },
        "gamma": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Gamma",
          "type": "number"
        },
        "ref_percentile": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 100,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ref Percentile"
        },
        "floor_percentile": {
          "default": 5.0,
          "exclusiveMaximum": 100,
          "minimum": 0,
          "title": "Floor Percentile",
          "type": "number"
        }
      },
      "title": "SignalConfig",
      "type": "object"
    },
    "SpectrumConfig": {
      "additionalProperties": false,
      "description": "Log-frequency STFT bands and independent normalized envelopes.",
      "properties": {
        "n_fft": {
          "default": 4096,
          "maximum": 16384,
          "minimum": 256,
          "title": "N Fft",
          "type": "integer"
        },
        "bands": {
          "default": 64,
          "maximum": 256,
          "minimum": 8,
          "title": "Bands",
          "type": "integer"
        },
        "low": {
          "default": 30.0,
          "exclusiveMaximum": 22050.0,
          "exclusiveMinimum": 0,
          "title": "Low",
          "type": "number"
        },
        "high": {
          "default": 16000.0,
          "exclusiveMinimum": 0,
          "maximum": 22050.0,
          "title": "High",
          "type": "number"
        },
        "floor_db": {
          "default": -60.0,
          "exclusiveMaximum": 0,
          "minimum": -120,
          "title": "Floor Db",
          "type": "number"
        },
        "ref_percentile": {
          "default": 99.5,
          "exclusiveMinimum": 0,
          "maximum": 100,
          "title": "Ref Percentile",
          "type": "number"
        },
        "gamma": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Gamma",
          "type": "number"
        },
        "attack_ms": {
          "default": 15.0,
          "minimum": 0,
          "title": "Attack Ms",
          "type": "number"
        },
        "release_ms": {
          "default": 180.0,
          "minimum": 0,
          "title": "Release Ms",
          "type": "number"
        }
      },
      "title": "SpectrumConfig",
      "type": "object"
    },
    "VisualizerConfig": {
      "additionalProperties": false,
      "description": "A bottom overlay containing one or more independently colored sources.",
      "properties": {
        "type": {
          "enum": [
            "waveform",
            "spectrum"
          ],
          "title": "Type",
          "type": "string"
        },
        "tracks": {
          "default": [
            {
              "stem": "mix",
              "source": null,
              "color": "#65d4ff"
            }
          ],
          "items": {
            "$ref": "#/$defs/VisualizerTrackConfig"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Tracks",
          "type": "array"
        },
        "layout": {
          "default": "overlay",
          "enum": [
            "overlay",
            "stacked",
            "side_by_side"
          ],
          "title": "Layout",
          "type": "string"
        },
        "left": {
          "default": 0.05,
          "maximum": 1,
          "minimum": 0,
          "title": "Left",
          "type": "number"
        },
        "width": {
          "default": 0.9,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Width",
          "type": "number"
        },
        "height": {
          "default": 0.18,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Height",
          "type": "number"
        },
        "bottom": {
          "default": 0.03,
          "maximum": 1,
          "minimum": 0,
          "title": "Bottom",
          "type": "number"
        },
        "gap": {
          "default": 0.025,
          "exclusiveMaximum": 0.5,
          "minimum": 0,
          "title": "Gap",
          "type": "number"
        },
        "opacity": {
          "default": 0.9,
          "maximum": 1,
          "minimum": 0,
          "title": "Opacity",
          "type": "number"
        },
        "gain": {
          "default": 1.0,
          "minimum": 0,
          "title": "Gain",
          "type": "number"
        },
        "background": {
          "default": "#050812",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Background",
          "type": "string"
        },
        "background_opacity": {
          "default": 0.25,
          "maximum": 1,
          "minimum": 0,
          "title": "Background Opacity",
          "type": "number"
        },
        "line_width": {
          "default": 2,
          "maximum": 8,
          "minimum": 1,
          "title": "Line Width",
          "type": "integer"
        },
        "fill_opacity": {
          "default": 0.18,
          "maximum": 1,
          "minimum": 0,
          "title": "Fill Opacity",
          "type": "number"
        },
        "bar_gap": {
          "default": 0.2,
          "exclusiveMaximum": 1,
          "minimum": 0,
          "title": "Bar Gap",
          "type": "number"
        },
        "waveform": {
          "$ref": "#/$defs/WaveformConfig"
        },
        "spectrum": {
          "$ref": "#/$defs/SpectrumConfig"
        }
      },
      "required": [
        "type"
      ],
      "title": "VisualizerConfig",
      "type": "object"
    },
    "VisualizerTrackConfig": {
      "additionalProperties": false,
      "properties": {
        "stem": {
          "anyOf": [
            {
              "enum": [
                "mix",
                "drums",
                "bass",
                "vocals",
                "other",
                "guitar",
                "piano"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stem"
        },
        "source": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "color": {
          "default": "#65d4ff",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Color",
          "type": "string"
        }
      },
      "title": "VisualizerTrackConfig",
      "type": "object"
    },
    "WaveformConfig": {
      "additionalProperties": false,
      "description": "Full-track peak normalization; window and points are display settings.",
      "properties": {
        "window_seconds": {
          "default": 4.0,
          "maximum": 30,
          "minimum": 0.05,
          "title": "Window Seconds",
          "type": "number"
        },
        "points": {
          "default": 512,
          "maximum": 4096,
          "minimum": 2,
          "title": "Points",
          "type": "integer"
        },
        "ref_percentile": {
          "default": 99.5,
          "exclusiveMinimum": 0,
          "maximum": 100,
          "title": "Ref Percentile",
          "type": "number"
        },
        "show_playhead": {
          "default": true,
          "title": "Show Playhead",
          "type": "boolean"
        }
      },
      "title": "WaveformConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Only schema v2 is accepted; legacy bands JSON has been removed.",
  "properties": {
    "schema_version": {
      "const": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "signals": {
      "additionalProperties": {
        "$ref": "#/$defs/SignalConfig"
      },
      "title": "Signals",
      "type": "object"
    },
    "effects": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EffectConfig"
      },
      "title": "Effects",
      "type": "array"
    },
    "separation": {
      "$ref": "#/$defs/SeparationConfig"
    },
    "visualizers": {
      "additionalProperties": {
        "$ref": "#/$defs/VisualizerConfig"
      },
      "title": "Visualizers",
      "type": "object"
    }
  },
  "required": [
    "schema_version"
  ],
  "title": "ProjectConfig",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/odoucet/beatbloom/blob/main/docs/config.schema.json"
}
