{
  "$defs": {
    "EffectConfig": {
      "additionalProperties": false,
      "description": "Map a named signal to an additive effect or a multiplicative brightness range.",
      "properties": {
        "signal": {
          "minLength": 1,
          "title": "Signal",
          "type": "string"
        },
        "effect": {
          "enum": [
            "bloom",
            "exposure",
            "saturation",
            "zoom",
            "brightness"
          ],
          "title": "Effect",
          "type": "string"
        },
        "amount": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount"
        },
        "range": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "minimum": 0,
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Range"
        }
      },
      "required": [
        "signal",
        "effect"
      ],
      "title": "EffectConfig",
      "type": "object"
    },
    "SeparationConfig": {
      "additionalProperties": false,
      "description": "Options that affect the identity of cached Demucs output.",
      "properties": {
        "backend": {
          "const": "demucs",
          "default": "demucs",
          "title": "Backend",
          "type": "string"
        },
        "model": {
          "default": "htdemucs_6s",
          "enum": [
            "htdemucs_6s",
            "htdemucs"
          ],
          "title": "Model",
          "type": "string"
        },
        "device": {
          "default": "auto",
          "pattern": "^(auto|cpu|mps|cuda(:[0-9]+)?)$",
          "title": "Device",
          "type": "string"
        },
        "shifts": {
          "default": 1,
          "minimum": 0,
          "title": "Shifts",
          "type": "integer"
        },
        "overlap": {
          "default": 0.25,
          "exclusiveMaximum": 1,
          "minimum": 0,
          "title": "Overlap",
          "type": "number"
        },
        "segment": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 7,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Segment"
        },
        "jobs": {
          "default": 0,
          "minimum": 0,
          "title": "Jobs",
          "type": "integer"
        },
        "seed": {
          "default": 0,
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        }
      },
      "title": "SeparationConfig",
      "type": "object"
    },
    "SignalConfig": {
      "additionalProperties": false,
      "description": "One source and its analysis/envelope parameters, independent of video FPS.",
      "properties": {
        "stem": {
          "anyOf": [
            {
              "enum": [
                "mix",
                "drums",
                "bass",
                "vocals",
                "other",
                "guitar",
                "piano"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stem"
        },
        "source": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "low": {
          "anyOf": [
            {
              "exclusiveMaximum": 22050.0,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Low"
        },
        "high": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 22050.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "High"
        },
        "feature": {
          "default": "onset",
          "enum": [
            "onset",
            "rms",
            "loudness"
          ],
          "title": "Feature",
          "type": "string"
        },
        "attack_ms": {
          "default": 10.0,
          "minimum": 0,
          "title": "Attack Ms",
          "type": "number"
        },
        "release_ms": {
          "default": 400.0,
          "minimum": 0,
          "title": "Release Ms",
          "type": "number"
        },
        "gate": {
          "default": 0.0,
          "exclusiveMaximum": 1,
          "minimum": 0,
          "title": "Gate",
          "type": "number"
        },
        "gamma": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Gamma",
          "type": "number"
        },
        "ref_percentile": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 100,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ref Percentile"
        },
        "floor_percentile": {
          "default": 5.0,
          "exclusiveMaximum": 100,
          "minimum": 0,
          "title": "Floor Percentile",
          "type": "number"
        }
      },
      "title": "SignalConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Only schema v2 is accepted; legacy bands JSON has been removed.",
  "properties": {
    "schema_version": {
      "const": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "signals": {
      "additionalProperties": {
        "$ref": "#/$defs/SignalConfig"
      },
      "minProperties": 1,
      "title": "Signals",
      "type": "object"
    },
    "effects": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EffectConfig"
      },
      "title": "Effects",
      "type": "array"
    },
    "separation": {
      "$ref": "#/$defs/SeparationConfig"
    }
  },
  "required": [
    "schema_version",
    "signals"
  ],
  "title": "ProjectConfig",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/odoucet/beatbloom/blob/main/docs/config.schema.json"
}
